# Sentinel — example environment file
#
# Copy to `.env` and edit. `.env` is gitignored; this file is committed and is
# the canonical list of what `src/sentinel/config.py` reads.
#
# Config is loaded by pydantic-settings with `env_prefix="SENTINEL_"`.
#
# Values here are working defaults where a sensible default exists, and obvious
# placeholders where it does not (database credentials, contact email). Anything
# that feeds a check threshold also feeds `check_run.config_hash`, so changing it
# changes the identity of a run and the prevalence numbers it reports.
#
# Quote any value containing spaces, parentheses or shell metacharacters.
# Unquoted parentheses break `set -a; source .env`.


# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SENTINEL_ENV=local                       # local | ci | prod
SENTINEL_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_FORMAT=json                 # json | console — json from day one

# Seeds every stochastic path: audit sampling, tie-breaking, shuffling.
# Without it two runs with identical config diverge and config_hash is a lie.
SENTINEL_RANDOM_SEED=20260922


# ---------------------------------------------------------------------------
# Database — PostgreSQL 15+, pg_trgm extension required
# Dialect is psycopg 3; install `psycopg[binary]`, not `psycopg2`.
# ---------------------------------------------------------------------------
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:changeme@localhost:5432/sentinel
SENTINEL_DB_POOL_SIZE=10
SENTINEL_DB_MAX_OVERFLOW=5
SENTINEL_DB_STATEMENT_TIMEOUT_MS=60000
SENTINEL_DB_ECHO=false                   # SQLAlchemy statement logging; noisy


# ---------------------------------------------------------------------------
# Polite pool identity
#
# Crossref, OpenAlex, Europe PMC and NCBI all widen rate limits materially when
# a real contact address is supplied. Set both before the first ingest run.
# ---------------------------------------------------------------------------
SENTINEL_CONTACT_EMAIL=you@example.edu
SENTINEL_USER_AGENT="sentinel-evidence/0.1 (+https://github.com/Arshajindal/sentinel-evidence)"


# ---------------------------------------------------------------------------
# Optional credentials
#
# None are required for Phase 1. Leave blank to use the free public tier.
# ---------------------------------------------------------------------------
SENTINEL_CROSSREF_PLUS_TOKEN=            # Crossref Plus, if you have one
SENTINEL_NCBI_API_KEY=                   # raises NCBI/Entrez rate limit to 10 rps
SENTINEL_OPENALEX_API_KEY=               # OpenAlex premium; not needed


# ---------------------------------------------------------------------------
# Source endpoints
#
# These are the documented base URLs as of the last check. They do move.
# Confirm each resolves before the first ingest run rather than trusting the
# value shipped here. Overridable mainly so the test suite can point harvesters
# at a local mock server.
# ---------------------------------------------------------------------------
SENTINEL_CROSSREF_BASE_URL=https://api.crossref.org
SENTINEL_OPENALEX_BASE_URL=https://api.openalex.org
SENTINEL_EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
SENTINEL_CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
SENTINEL_NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils


# ---------------------------------------------------------------------------
# HTTP client
# ---------------------------------------------------------------------------
SENTINEL_HTTP_TIMEOUT_S=30
SENTINEL_HTTP_MAX_RETRIES=5
SENTINEL_HTTP_BACKOFF_BASE_S=1.0         # exponential; retry on 429 and 5xx only
SENTINEL_HTTP_MAX_CONNECTIONS=20


# ---------------------------------------------------------------------------
# Per-source rate limits — requests/second, token bucket
#
# Conservative by design. Raise only after confirming the published limit and
# that a contact email is being sent.
# ---------------------------------------------------------------------------
SENTINEL_RATE_CROSSREF_RPS=5
SENTINEL_RATE_OPENALEX_RPS=10
SENTINEL_RATE_EUROPEPMC_RPS=5
SENTINEL_RATE_CLINICALTRIALS_RPS=5
SENTINEL_RATE_NCBI_RPS=3                 # 10 with an API key

# OpenAlex also enforces a daily quota independent of rate. Bulk ingest
# (ADR-005) keeps API usage well under it; this guard exists for the fallback path.
SENTINEL_OPENALEX_DAILY_QUOTA=100000


# ---------------------------------------------------------------------------
# Bulk snapshots (ADR-005 — prefer these over API pagination)
#
# Local paths to downloaded distributions. Existence checking becomes a table
# join once these are ingested. These directories are gitignored; an OpenAlex
# snapshot is tens of gigabytes.
# ---------------------------------------------------------------------------
SENTINEL_DATA_DIR=./data
SENTINEL_CROSSREF_SNAPSHOT_PATH=./data/crossref/
SENTINEL_OPENALEX_SNAPSHOT_URI=s3://openalex/data/
SENTINEL_OPENALEX_S3_NO_SIGN_REQUEST=true     # the snapshot bucket is public
SENTINEL_PMC_OA_SNAPSHOT_PATH=./data/pmc-oa/
SENTINEL_RETRACTION_WATCH_CSV_PATH=./data/retraction-watch/retractions.csv


# ---------------------------------------------------------------------------
# Pipeline batching and concurrency
# ---------------------------------------------------------------------------
SENTINEL_INGEST_BATCH_SIZE=1000          # rows per upsert
SENTINEL_INGEST_MAX_CONCURRENCY=8
SENTINEL_RESOLVE_BATCH_SIZE=500
SENTINEL_CHECK_BATCH_SIZE=200


# ---------------------------------------------------------------------------
# Entity resolution cascade (brief §8)
#
# Stages 1–3 are exact matches and have no tunables. These govern stages 4 & 5.
# ---------------------------------------------------------------------------
SENTINEL_RESOLVE_TRIGRAM_MIN=0.85        # stage 4: title sim, with author + year
SENTINEL_RESOLVE_TRIGRAM_STRICT=0.92     # stage 5: title sim alone, marked weak
SENTINEL_RESOLVE_YEAR_TOLERANCE=1        # stage 4: year +/- this
SENTINEL_RESOLVE_AMBIGUOUS_MARGIN=0.02   # candidates this close tie -> ambiguous


# ---------------------------------------------------------------------------
# Check parameters
#
# Part of config_hash. Widening an applicability gate trades precision for
# recall, which is the wrong direction for this tier (ADR-010).
# ---------------------------------------------------------------------------
SENTINEL_CHECKS_ENABLED=C01,C02,C03,C04,C05

# C02 — retraction status.
# Papers sit in press 6–12 months, so a citation made shortly after a notice
# could not have known. Inside this window the finding downgrades to `low`
# and is framed as "retracted while in press". See ADR-017.
SENTINEL_C02_GRACE_MONTHS=6

# C03 — statistical self-consistency.
SENTINEL_C03_ALPHA=0.05                  # the decision boundary a `gross` error crosses
SENTINEL_C03_ALLOW_ONE_TAILED=true       # ADR-009 — do not disable without reading it

# C04 — GRIM. Applicability gate is deliberately strict.
SENTINEL_C04_MAX_N=100                   # GRIM is uninformative above this
SENTINEL_C04_MIN_DECIMALS=2              # means reported coarser than this: not_applicable
SENTINEL_C04_EPSILON=1e-9                # float slack in the granularity comparison

# C05 — results reporting compliance.
SENTINEL_C05_OVERDUE_MONTHS=12           # completed this long ago and still no results


# ---------------------------------------------------------------------------
# Runs and output
# ---------------------------------------------------------------------------
SENTINEL_DEFAULT_CORPUS_LABEL=dev-sample
SENTINEL_EXPORT_DIR=./out
