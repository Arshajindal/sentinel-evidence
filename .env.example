# Sentinel — example environment file
#
# Copy to `.env` and edit. `.env` is gitignored; this file is committed and is
# the canonical list of what `src/sentinel/config.py` reads.
#
# Config is loaded by pydantic-settings with `env_prefix="SENTINEL_"`.
#
# Values here are working defaults where a sensible default exists, and obvious
# placeholders where it does not (database credentials, contact email). Anything
# that feeds a check threshold also feeds `check_run.config_hash`, so changing it
# changes the identity of a run and the prevalence numbers it reports.
#
# Quote any value containing spaces, parentheses or shell metacharacters.
# Unquoted parentheses break `set -a; source .env`.


# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SENTINEL_ENV=local                       # local | ci | prod
SENTINEL_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_FORMAT=json                 # json | console — json from day one

# Seeds every stochastic path: audit sampling, tie-breaking, shuffling.
# Without it two runs with identical config diverge and config_hash is a lie.
SENTINEL_RANDOM_SEED=20260922


# ---------------------------------------------------------------------------
# Database — PostgreSQL 15+ with pg_trgm and, from Phase 2, pgvector
# Dialect is psycopg 3; install `psycopg[binary]`, not `psycopg2`.
# The local server is the container in docker/compose.yaml (ADR-043), on
# 127.0.0.1:5434. Use 127.0.0.1, not localhost: the container has no IPv6.
# ---------------------------------------------------------------------------
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:changeme@127.0.0.1:5434/sentinel
SENTINEL_DB_POOL_SIZE=10
SENTINEL_DB_MAX_OVERFLOW=5
SENTINEL_DB_STATEMENT_TIMEOUT_MS=60000
SENTINEL_DB_ECHO=false                   # SQLAlchemy statement logging; noisy


# ---------------------------------------------------------------------------
# Polite pool identity
#
# Crossref, OpenAlex, Europe PMC and NCBI all widen rate limits materially when
# a real contact address is supplied. Set both before the first ingest run.
# ---------------------------------------------------------------------------
SENTINEL_CONTACT_EMAIL=you@example.edu
SENTINEL_USER_AGENT="sentinel-evidence/0.1 (+https://github.com/Arshajindal/sentinel-evidence)"


# ---------------------------------------------------------------------------
# Optional credentials
#
# None are required for Phase 1. Leave blank to use the free public tier.
# ---------------------------------------------------------------------------
SENTINEL_CROSSREF_PLUS_TOKEN=            # Crossref Plus, if you have one
SENTINEL_NCBI_API_KEY=                   # raises NCBI/Entrez rate limit to 10 rps
# OpenAlex: free key from openalex.org/signup raises the daily budget from
# about $0.10 to $1 (ADR-032). Sent as a Bearer header, never in the URL.
SENTINEL_OPENALEX_API_KEY=


# ---------------------------------------------------------------------------
# Source endpoints
#
# These are the documented base URLs as of the last check. They do move.
# Confirm each resolves before the first ingest run rather than trusting the
# value shipped here. Overridable mainly so the test suite can point harvesters
# at a local mock server.
# ---------------------------------------------------------------------------
SENTINEL_CROSSREF_BASE_URL=https://api.crossref.org
SENTINEL_OPENALEX_BASE_URL=https://api.openalex.org
SENTINEL_EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
# Text-mined NCT numbers, with the section each appears in (S1.6 trial links).
SENTINEL_EUROPEPMC_ANNOTATIONS_BASE_URL=https://www.ebi.ac.uk/europepmc/annotations_api
SENTINEL_CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
SENTINEL_NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# doi.org handle API — GET {base}/{doi}. Confirms a DOI exists at any
# registration agency (DataCite etc.), not just Crossref. Asked before C01
# flags a reference whose DOI Crossref doesn't know (sentinel-project.md §9.5).
SENTINEL_DOI_HANDLE_BASE_URL=https://doi.org/api/handles


# ---------------------------------------------------------------------------
# HTTP client
# ---------------------------------------------------------------------------
SENTINEL_HTTP_TIMEOUT_S=30
SENTINEL_HTTP_MAX_RETRIES=5
SENTINEL_HTTP_BACKOFF_BASE_S=1.0         # exponential; retry on 429 and 5xx only
SENTINEL_HTTP_MAX_CONNECTIONS=20


# ---------------------------------------------------------------------------
# Per-source rate limits — requests/second, token bucket
#
# Conservative by design. Raise only after confirming the published limit and
# that a contact email is being sent.
# ---------------------------------------------------------------------------
SENTINEL_RATE_CROSSREF_RPS=5            # polite pool (mailto) allows 10, 3 concurrent
SENTINEL_RATE_OPENALEX_RPS=10           # 30 with a free key
SENTINEL_RATE_EUROPEPMC_RPS=5
SENTINEL_RATE_CLINICALTRIALS_RPS=5
SENTINEL_RATE_NCBI_RPS=3                 # 10 with an API key
SENTINEL_RATE_DOI_HANDLE_RPS=5

# OpenAlex meters usage in dollars (ADR-032): DOI lookups are free, searches
# cost $0.001 each. Searches stop, with an error, once this much has been
# spent today or the server reports the budget gone. Set to 1.0 with a key.
SENTINEL_OPENALEX_DAILY_BUDGET_USD=0.10


# ---------------------------------------------------------------------------
# Local data files (ADR-020)
#
# Crossref and OpenAlex are API-only at current scale (ADR-020); no snapshot
# of either is downloaded. These directories are gitignored.
# ---------------------------------------------------------------------------
SENTINEL_DATA_DIR=./data
SENTINEL_PMC_OA_SNAPSHOT_PATH=./data/pmc-oa/
# Corpus papers' full-text JATS XML, fetched once and reused (C03, Phase 2).
SENTINEL_FULLTEXT_CACHE_DIR=./data/fulltext

# Retraction Watch: `git clone https://gitlab.com/crossref/retraction-watch-data`
# into ./data and point this at the CSV inside the clone. Don't use the old
# Crossref Labs API link; it is unmaintained and returns stale data.
SENTINEL_RETRACTION_WATCH_CSV_PATH=./data/retraction-watch-data/retraction_watch.csv

# ClinicalTrials.gov is fetched one study at a time by default
# (/api/v2/studies/{nctId}). The bulk zip — every study, same JSON schema —
# is reserved for the 10,000-paper run or registry-wide statistics
# (ADR-019 as amended by ADR-023).
SENTINEL_CLINICALTRIALS_BULK_URL=https://clinicaltrials.gov/api/v2/studies/download?format=json.zip
SENTINEL_CLINICALTRIALS_SNAPSHOT_PATH=./data/clinicaltrials/

# OpenAPI spec — generate or validate the trial models against this rather
# than hand-writing them from a nested schema.
SENTINEL_CLINICALTRIALS_OAS_URL=https://clinicaltrials.gov/api/oas/v2


# ---------------------------------------------------------------------------
# Privacy filtering (ADR-018, extended by ADR-025)
#
# ClinicalTrials.gov study records contain named individuals and their contact
# details. Sentinel stores none of it. These fields are dropped during
# normalisation, before anything reaches the database.
#
# Leave this on. The trial client refuses to run with it off.
# ---------------------------------------------------------------------------
SENTINEL_STRIP_PERSONAL_FIELDS=true
SENTINEL_TRIAL_DROP_PATHS=protocolSection.contactsLocationsModule.centralContacts,protocolSection.contactsLocationsModule.overallOfficials,protocolSection.contactsLocationsModule.locations[].contacts,protocolSection.sponsorCollaboratorsModule.responsibleParty,resultsSection.moreInfoModule.pointOfContact


# ---------------------------------------------------------------------------
# Pipeline batching and concurrency
# ---------------------------------------------------------------------------
SENTINEL_INGEST_BATCH_SIZE=1000          # rows per upsert
SENTINEL_INGEST_MAX_CONCURRENCY=8
SENTINEL_RESOLVE_BATCH_SIZE=500
SENTINEL_CHECK_BATCH_SIZE=200


# ---------------------------------------------------------------------------
# Entity resolution cascade (sentinel-project.md §9.5)
#
# Stages 1–3 are exact matches and have no tunables. These govern stages 4 & 5.
# ---------------------------------------------------------------------------
SENTINEL_RESOLVE_TRIGRAM_MIN=0.85        # stage 4: title sim, with author + year
SENTINEL_RESOLVE_TRIGRAM_STRICT=0.92     # stage 5: title sim alone, marked weak
SENTINEL_RESOLVE_YEAR_TOLERANCE=1        # stage 4: year +/- this
SENTINEL_RESOLVE_AMBIGUOUS_MARGIN=0.02   # candidates this close tie -> ambiguous


# ---------------------------------------------------------------------------
# Check parameters
#
# Part of config_hash. Widening an applicability gate trades precision for
# recall, which is the wrong direction for this tier (ADR-010).
# ---------------------------------------------------------------------------
SENTINEL_CHECKS_ENABLED=C01,C02,C03,C04,C05

# C01 — reference existence (ADR-035). Before flagging a reference "could not
# be verified", C01 looks for evidence the work exists under a variant title:
# a candidate with the same first author and year at this similarity or more...
SENTINEL_C01_NEAR_MATCH_MIN=0.6
# ...or a candidate this similar in the same year whatever its author field says.
SENTINEL_C01_SAME_TITLE_MIN=0.85

# C02 — retraction status.
# Papers sit in press 6–12 months, so a citation made shortly after a notice
# could not have known. Inside this window the finding downgrades to `low`
# and is framed as "retracted while in press". See ADR-017.
SENTINEL_C02_GRACE_MONTHS=6

# C03 — statistical self-consistency.
SENTINEL_C03_ALPHA=0.05                  # the decision boundary a `gross` error crosses
SENTINEL_C03_ALLOW_ONE_TAILED=true       # ADR-009 — do not disable without reading it

# C04 — GRIM. Applicability gate is deliberately strict.
SENTINEL_C04_MAX_N=100                   # GRIM is uninformative above this
SENTINEL_C04_MIN_DECIMALS=2              # means reported coarser than this: not_applicable
SENTINEL_C04_EPSILON=1e-9                # float slack in the granularity comparison

# C05 — results reporting (sentinel-project.md §9.7).
# Flag when primary completion is more than this many months past and no
# results are posted. Replaces SENTINEL_C05_OVERDUE_MONTHS.
SENTINEL_C05_GRACE_MONTHS=12


# ---------------------------------------------------------------------------
# Passages (sentinel-project.md §10.1 item 2, ADR-046)
#
# A work's text is cut into windows of whole sentences, section by section.
# These sizes decide what retrieval can find, so they feed config_hash and
# appear in passage.splitter_ver (e.g. 1.0.0/150-300-1).
# ---------------------------------------------------------------------------
SENTINEL_PASSAGE_MIN_WORDS=150           # a window closes once it reaches this
SENTINEL_PASSAGE_MAX_WORDS=300           # and never grows past this
SENTINEL_PASSAGE_OVERLAP_SENTENCES=1     # sentences repeated at the start of the next window


# ---------------------------------------------------------------------------
# Embeddings (sentinel-project.md §10.1 item 4, ADR-047)
#
# The MedCPT article encoder runs in-process with PyTorch (pip install -e ".[ml]").
# The model and the exact revision of its weights decide every vector, so both
# feed config_hash; passage_embedding.model records them as model@revision.
# ---------------------------------------------------------------------------
SENTINEL_EMBED_ARTICLE_MODEL=ncbi/MedCPT-Article-Encoder
SENTINEL_EMBED_ARTICLE_REVISION=d05a736da4bb84ee4057b7f7999485be6ed85465
SENTINEL_EMBED_BATCH_SIZE=8              # passages per forward pass; speed only


# ---------------------------------------------------------------------------
# Retrieval (sentinel-project.md §10.1 item 5, ADR-048)
#
# For a claim: BM25 and dense search each return RETRIEVE_DEPTH passages,
# reciprocal rank fusion merges them, and the cross-encoder reranks the fused
# top RETRIEVE_DEPTH and keeps RETRIEVE_KEEP. Every value here decides what is
# retrieved, so all feed config_hash.
# ---------------------------------------------------------------------------
SENTINEL_EMBED_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
SENTINEL_EMBED_QUERY_REVISION=d83a36cc6b8e3a5c5e9d9d6ba156808c1643dcbc
SENTINEL_RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
SENTINEL_RERANK_REVISION=71caf65d4927987813984f54c284405a13fcca49
SENTINEL_BM25_K1=1.5                     # term-frequency saturation (bm25s default)
SENTINEL_BM25_B=0.75                     # length normalisation (bm25s default)
SENTINEL_RETRIEVE_DENSE_METRIC=dot       # dot | cosine; dot won S2.6 on val (ADR-050), as MedCPT is trained for it
SENTINEL_RETRIEVE_RRF_K=60               # §10.1
SENTINEL_RETRIEVE_DEPTH=50               # §10.1: rerank the top 50
SENTINEL_RETRIEVE_KEEP=5                 # §10.1: keep 3-5
SENTINEL_BM25_INDEX_DIR=./data/bm25      # saved BM25 indexes (gitignored)
SENTINEL_MLFLOW_TRACKING_URI=http://127.0.0.1:5000   # experiments and the model registry (ADR-043)


# ---------------------------------------------------------------------------
# External evaluation set: SciFact (Q6, ADR-049)
#
# Claims and evidence labels CC BY 4.0, abstracts ODC-By 1.0 (the authors'
# LICENSE.md at github.com/allenai/scifact). The URL is the authors' "latest"
# release, so the download is checked against this SHA-256 before use.
# Downloaded and unpacked under SENTINEL_DATA_DIR/external/scifact (gitignored).
# ---------------------------------------------------------------------------
SENTINEL_SCIFACT_URL=https://scifact.s3-us-west-2.amazonaws.com/release/latest/data.tar.gz
SENTINEL_SCIFACT_SHA256=11c621288d41ac144d29b13b0f8503b3820b7d6e8b1f6ff24dff335c196d76be

# ---------------------------------------------------------------------------
# Language-model gateway: claim skeletons (Q7, ADR-053)
#
# ASU Research Computing's free, on-premises, OpenAI-compatible gateway
# (docs.rc.asu.edu/ai/api). Create a key in the Voyager portal
# (voyager.rc.asu.edu, LLM Access tab; needs the ASU VPN or campus network).
# Keep the key only in .env. The model is chosen per command (--model) and
# recorded on every claim row, so it has no setting here.
# ---------------------------------------------------------------------------
SENTINEL_LLM_BASE_URL=https://openai.rc.asu.edu/v1
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_TIMEOUT_S=300
SENTINEL_LLM_WORKERS=4
SENTINEL_RATE_LLM_RPS=10

# ---------------------------------------------------------------------------
# Corpus selection (sentinel-project.md §9.2, ADR-028)
#
# The Europe PMC query that defines the working corpus. `sentinel corpus
# select` samples from its hits with SENTINEL_RANDOM_SEED and records the
# query, seed and date in the `corpus` table. Single quotes keep the inner
# double quotes intact.
# ---------------------------------------------------------------------------
SENTINEL_CORPUS_QUERY='ACCESSION_TYPE:nct AND OPEN_ACCESS:y AND IN_PMC:y AND HAS_REFLIST:y AND PUB_YEAR:[2015 TO 2024] AND PUB_TYPE:"Randomized Controlled Trial"'


# ---------------------------------------------------------------------------
# Runs and output
# ---------------------------------------------------------------------------
SENTINEL_DEFAULT_CORPUS_LABEL=dev-sample
SENTINEL_EXPORT_DIR=./out


# ---------------------------------------------------------------------------
# Local services — not SENTINEL_-prefixed, so Settings ignores them (ADR-043)
#
# docker/compose.yaml reads the two passwords when it creates the volume:
#   docker compose -f docker/compose.yaml --env-file .env up -d
# APP_DB_PASSWORD is the `sentinel` role's; put the same value in the URLs.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme-superuser
APP_DB_PASSWORD=changeme

# Disposable database for the test suite; migration tests downgrade it to base.
TEST_DATABASE_URL=postgresql+psycopg://sentinel:changeme@127.0.0.1:5434/sentinel_test

# MLflow tracking server (ADR-043). Start it with:
#   dotenv run -- mlflow server
# then open http://127.0.0.1:5000. Runs and the model registry live in the
# `mlflow` database; artifacts on disk under data/ (gitignored).
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://sentinel:changeme@127.0.0.1:5434/mlflow
MLFLOW_ARTIFACTS_DESTINATION=./data/mlartifacts
